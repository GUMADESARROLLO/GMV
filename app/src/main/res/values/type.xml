<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Parent containers for M3 type scale hierarchy -->
    <style name="TextAppearance" />
    <style name="TextAppearance.M3" />

    <!-- M3 Type Scale: Display -->
    <style name="TextAppearance.M3.DisplayLarge">
        <item name="android:textFontWeight">800</item>
        <item name="android:textSize">57sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineHeight">64sp</item>
        <item name="android:fontFamily">@font/archivo</item>
    </style>
    <style name="TextAppearance.M3.DisplayMedium">
        <item name="android:textFontWeight">800</item>
        <item name="android:textSize">45sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineHeight">52sp</item>
        <item name="android:fontFamily">@font/archivo</item>
    </style>
    <style name="TextAppearance.M3.DisplaySmall">
        <item name="android:textFontWeight">800</item>
        <item name="android:textSize">36sp</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:lineHeight">44sp</item>
        <item name="android:fontFamily">@font/archivo</item>
    </style>

    <!-- M3 Type Scale: Headline -->
    <style name="TextAppearance.M3.HeadlineLarge">
        <item name="android:textFontWeight">800</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:lineHeight">40sp</item>
        <item name="android:fontFamily">@font/archivo</item>
    </style>
    <style name="TextAppearance.M3.HeadlineMedium">
        <item name="android:textFontWeight">800</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineHeight">36sp</item>
        <item name="android:fontFamily">@font/archivo</item>
    </style>
    <style name="TextAppearance.M3.HeadlineSmall">
        <item name="android:textFontWeight">800</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">-0.005</item>
        <item name="android:lineHeight">32sp</item>
        <item name="android:fontFamily">@font/archivo</item>
    </style>

    <!-- M3 Type Scale: Title -->
    <style name="TextAppearance.M3.TitleLarge">
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineHeight">28sp</item>
        <item name="android:fontFamily">@font/archivo</item>
    </style>
    <style name="TextAppearance.M3.TitleMedium">
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:lineHeight">24sp</item>
        <item name="android:fontFamily">@font/archivo</item>
    </style>
    <style name="TextAppearance.M3.TitleSmall">
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.007</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:fontFamily">@font/archivo</item>
    </style>

    <!-- M3 Type Scale: Body -->
    <style name="TextAppearance.M3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.003</item>
        <item name="android:lineHeight">24sp</item>
        <item name="android:fontFamily">@font/archivo</item>
    </style>
    <style name="TextAppearance.M3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:fontFamily">@font/archivo</item>
    </style>
    <style name="TextAppearance.M3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:lineHeight">16sp</item>
        <item name="android:fontFamily">@font/archivo</item>
    </style>

    <!-- M3 Type Scale: Label -->
    <style name="TextAppearance.M3.LabelLarge">
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.007</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:fontFamily">@font/archivo</item>
    </style>
    <style name="TextAppearance.M3.LabelMedium">
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:lineHeight">16sp</item>
        <item name="android:fontFamily">@font/archivo</item>
    </style>
    <style name="TextAppearance.M3.LabelSmall">
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:lineHeight">16sp</item>
        <item name="android:fontFamily">@font/archivo</item>
    </style>

    <!-- Cifras/montos: Barlow Condensed tabular, igual que los números del monitor -->
    <style name="TextAppearance.GMV.Numero" parent="">
        <item name="android:fontFamily">@font/barlow_condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Texto del control segmentado (tabs tipo iOS): sin mayúsculas, peso 700 -->
    <style name="TextAppearance.GMV.Segmento" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:fontFamily">@font/archivo</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Medium" />
    <style name="TextAppearance.Medium.Bold">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.BottomNav">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/archivo</item>
    </style>

    <style name="KeyStyle" parent="Widget.GMV.Tecla">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">5dp</item>
    </style>
</resources>
