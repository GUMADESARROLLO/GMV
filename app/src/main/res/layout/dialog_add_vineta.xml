<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:minWidth="300dp">

    <TextView
        android:id="@+id/id_title_frm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Digite el Nº de recibo."
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/edt_cantidad_vineta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nº Recibo: "
        android:inputType="number"
        android:textSize="14sp"
        android:padding="12dp"
        android:background="@drawable/bg_input_dark"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/bt_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="@color/text_hint"
            android:background="@android:color/transparent"
            android:minWidth="90dp" />

        <Button
            android:id="@+id/bt_add"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Agregar"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="@color/colorUmkPrimaryDark"
            android:background="@android:color/transparent"
            android:minWidth="90dp" />

    </LinearLayout>

</LinearLayout>
