<?xml version="1.0" encoding="utf-8"?>
<!-- Perfil del cliente — superficie clara, tarjetas blancas con borde línea, íconos en contenedores tintados.
     Jerarquía: identidad → resumen de crédito → métricas 2×2 → aumento → acciones → documentos. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_perfil"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/umk_mist">

<androidx.core.widget.NestedScrollView
    android:id="@+id/nested_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/umk_mist"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <!-- ═══ Header: botón circular + título + llamar ═══ -->
        <LinearLayout
            android:id="@+id/toolbar_header"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginHorizontal="-16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_boton_circular"
                android:contentDescription="Regresar"
                android:padding="11dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_arrow_left"
                app:tint="@color/umk_ink" />

            <TextView
                android:id="@+id/tv_toolbar_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:letterSpacing="-0.01"
                android:text="Perfil cliente"
                android:textColor="@color/umk_ink"
                android:textFontWeight="800"
                android:textSize="20sp" />




            <ImageButton
                android:id="@+id/row_telefono"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_boton_circular"
                android:contentDescription="Llamar al cliente"
                android:padding="12dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_phone"
                app:tint="@color/umk_royal" />
        </LinearLayout>

        <!-- ═══ Identidad (compacta): avatar + nombre / código + chips; contacto en líneas cortas ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_tarjeta_perfil"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_avatar_cliente"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_chip_pill"
                    android:backgroundTint="@color/umk_royal_tint"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="CL"
                    android:textColor="@color/umk_royal"
                    android:textFontWeight="800"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/id_perfil_name_cliente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:letterSpacing="-0.01"
                        android:maxLines="2"
                        android:text="Nombre del cliente"
                        android:textColor="@color/umk_ink"
                        android:textFontWeight="800"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_cod_cliente"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00000"
                            android:textColor="@color/umk_ink_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/id_condicion_pago"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip_pill"
                            android:backgroundTint="@color/umk_royal_tint"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="Crédito 00 días"
                            android:textColor="@color/umk_royal"
                            android:textFontWeight="700"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_chip_moroso"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_chip_pill"
                            android:backgroundTint="@color/umk_danger_tint"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="En mora"
                            android:textColor="@color/umk_danger"
                            android:textFontWeight="700"
                            android:textSize="11sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Teléfono (la llamada se hace con el botón circular del header) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_phone"
                    app:tint="@color/umk_ink_muted" />

                <TextView
                    android:id="@+id/id_tele"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="8244-9100"
                    android:textColor="@color/umk_ink"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Dirección: máximo 2 líneas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="1dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pin"
                    app:tint="@color/umk_ink_muted" />

                <TextView
                    android:id="@+id/txt_direccion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/lorem_ipsum"
                    android:textColor="@color/umk_ink_soft"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ Acciones (junto a la ficha: lo que se hace con este cliente) ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_list_articulos"
                android:contentDescription="Nuevo pedido"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_icono_tile"
                android:backgroundTint="@color/umk_success"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="14dp"
                android:stateListAnimator="@animator/button_press">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_cart_black"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Pedido"
                    android:textColor="@color/white"
                    android:textFontWeight="700"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_recibo_colector"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tarjeta_perfil"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="14dp"
                android:stateListAnimator="@animator/button_press">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_add_card"
                    app:tint="@color/umk_royal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Recibos"
                    android:textColor="@color/umk_ink"
                    android:textFontWeight="700"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/id_history_last_3m"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tarjeta_perfil"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="14dp"
                android:stateListAnimator="@animator/button_press">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_history"
                    app:tint="@color/umk_royal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Historial"
                    android:textColor="@color/umk_ink"
                    android:textFontWeight="700"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/id_search_lotes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tarjeta_perfil"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="14dp"
                android:stateListAnimator="@animator/button_press">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_search"
                    app:tint="@color/umk_royal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Lotes"
                    android:textColor="@color/umk_ink"
                    android:textFontWeight="700"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ Resumen de crédito ═══ -->
        <LinearLayout
            android:id="@+id/id_card_disp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tarjeta_perfil"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Crédito disponible"
                        android:textColor="@color/umk_ink_soft"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/id_perfil_disponible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFeatureSettings="tnum"
                        android:letterSpacing="-0.02"
                        android:text="C$ 12,000.00"
                        android:textColor="@color/umk_ink"
                        android:textFontWeight="800"
                        android:textSize="30sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_chip_uso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_pill"
                        android:backgroundTint="@color/status_active_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="0% usado"
                        android:textColor="@color/status_active_text"
                        android:textFontWeight="700"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_credito_usado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="del límite"
                        android:textColor="@color/umk_ink_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Barra segmentada: saldo · pedido · disponible (pesos asignados en código) -->
            <LinearLayout
                android:id="@+id/lyt_barra_credito"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/seg_saldo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmento"
                    android:backgroundTint="@color/umk_royal" />

                <View
                    android:id="@+id/seg_pedido"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmento"
                    android:backgroundTint="@color/umk_cyan" />

                <View
                    android:id="@+id/seg_disponible"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmento"
                    android:backgroundTint="@color/umk_line" />
            </LinearLayout>

            <!-- Leyenda -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_chip_pill"
                    android:backgroundTint="@color/umk_royal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Saldo"
                    android:textColor="@color/umk_ink_soft"
                    android:textSize="12sp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_chip_pill"
                    android:backgroundTint="@color/umk_cyan" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Pedido"
                    android:textColor="@color/umk_ink_soft"
                    android:textSize="12sp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_chip_pill"
                    android:backgroundTint="@color/umk_silver" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Disponible"
                    android:textColor="@color/umk_ink_soft"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ Métricas 2×2 ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Saldo -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tarjeta_perfil"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icono_tile"
                    android:backgroundTint="@color/umk_danger_tint"
                    android:importantForAccessibility="no"
                    android:padding="9dp"
                    android:src="@drawable/ic_receipt_long"
                    app:tint="@color/umk_danger" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saldo"
                        android:textColor="@color/umk_ink_soft"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/id_perfil_saldo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:text="C$ 2,000.00"
                        android:textColor="@color/umk_ink"
                        android:textFontWeight="800"
                        android:textSize="15sp"
                        app:autoSizeMaxTextSize="15sp"
                        app:autoSizeMinTextSize="11sp"
                        app:autoSizeTextType="uniform" />

                    <TextView
                        android:id="@+id/tv_saldo_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0% del límite"
                        android:textColor="@color/umk_ink_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pedido en curso -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tarjeta_perfil"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icono_tile"
                    android:backgroundTint="@color/umk_cyan_tint"
                    android:importantForAccessibility="no"
                    android:padding="9dp"
                    android:src="@drawable/ic_cart_black"
                    app:tint="@color/umk_cyan_ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pedido"
                        android:textColor="@color/umk_ink_soft"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/id_perfil_pedido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:text="C$ 0.00"
                        android:textColor="@color/umk_ink"
                        android:textFontWeight="800"
                        android:textSize="15sp"
                        app:autoSizeMaxTextSize="15sp"
                        app:autoSizeMinTextSize="11sp"
                        app:autoSizeTextType="uniform" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Carrito actual"
                        android:textColor="@color/umk_ink_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Límite -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tarjeta_perfil"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icono_tile"
                    android:backgroundTint="@color/umk_royal_tint"
                    android:importantForAccessibility="no"
                    android:padding="9dp"
                    android:src="@drawable/ic_monetization_on"
                    app:tint="@color/umk_royal" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Límite"
                        android:textColor="@color/umk_ink_soft"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/id_perfil_limite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:text="C$ 14,000.00"
                        android:textColor="@color/umk_ink"
                        android:textFontWeight="800"
                        android:textSize="15sp"
                        app:autoSizeMaxTextSize="15sp"
                        app:autoSizeMinTextSize="11sp"
                        app:autoSizeTextType="uniform" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="De crédito"
                        android:textColor="@color/umk_ink_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Vencido (se llena al cargar el perfil) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tarjeta_perfil"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icono_tile"
                    android:backgroundTint="@color/status_pending_bg"
                    android:importantForAccessibility="no"
                    android:padding="9dp"
                    android:src="@drawable/ic_schedule"
                    app:tint="@color/status_pending_text" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vencido"
                        android:textColor="@color/umk_ink_soft"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_perfil_vencido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="@color/umk_ink"
                        android:textFontWeight="800"
                        android:textSize="15sp"
                        app:autoSizeMaxTextSize="15sp"
                        app:autoSizeMinTextSize="11sp"
                        app:autoSizeTextType="uniform" />

                    <TextView
                        android:id="@+id/tv_vencido_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cargando…"
                        android:textColor="@color/umk_ink_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ Tarjeta destacada: solicitar aumento ═══ -->
        <LinearLayout
            android:id="@+id/btn_solicitar_incremento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_icono_tile"
            android:backgroundTint="@color/umk_cyan_tint"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:stateListAnimator="@animator/button_press">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_chip_pill"
                android:backgroundTint="@color/umk_paper"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_up"
                app:tint="@color/umk_cyan_ink" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Solicitar aumento de crédito"
                    android:textColor="@color/umk_ink"
                    android:textFontWeight="800"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_aumento_detalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingMultiplier="1.15"
                    android:text="Pide un límite mayor para este cliente."
                    android:textColor="@color/umk_ink_soft"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/umk_ink_soft" />
        </LinearLayout>

        <!-- ═══ Documentos: control segmentado ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Documentos"
            android:textColor="@color/umk_ink"
            android:textFontWeight="800"
            android:textSize="17sp" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_segmentado_track"
            app:tabGravity="fill"
            app:tabIndicator="@drawable/bg_segmentado_indicador"
            app:tabIndicatorAnimationMode="elastic"
            app:tabIndicatorColor="@color/umk_paper"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorGravity="stretch"
            app:tabMode="fixed"
            app:tabRippleColor="@android:color/transparent"
            app:tabSelectedTextColor="@color/umk_ink"
            app:tabTextAppearance="@style/TextAppearance.GMV.Segmento"
            app:tabTextColor="@color/umk_ink_soft">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Facturas" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mora" />

        </com.google.android.material.tabs.TabLayout>

        <FrameLayout
            android:id="@+id/lyt_facturas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_hint_seleccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="Mantén presionada una factura para cobrar varias de contado"
                    android:textColor="@color/umk_ink_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <include
                    android:id="@+id/lyt_empty_result"
                    layout="@layout/include_empty_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />

            </LinearLayout>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/lyt_saldos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_tarjeta_perfil"
                    android:orientation="vertical"
                    android:paddingVertical="4dp">

                    <include android:id="@+id/row_no_vencido" layout="@layout/item_mora_row" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/umk_line" />
                    <include android:id="@+id/row_d30" layout="@layout/item_mora_row" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/umk_line" />
                    <include android:id="@+id/row_d60" layout="@layout/item_mora_row" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/umk_line" />
                    <include android:id="@+id/row_d90" layout="@layout/item_mora_row" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/umk_line" />
                    <include android:id="@+id/row_d120" layout="@layout/item_mora_row" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="16dp" android:background="@color/umk_line" />
                    <include android:id="@+id/row_m120" layout="@layout/item_mora_row" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

    <!-- Barra de selección múltiple: fija abajo para que siempre esté a la vista junto a la lista -->
    <LinearLayout
        android:id="@+id/lyt_barra_seleccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_panel_inferior"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_close_selection"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_boton_circular"
            android:contentDescription="Cancelar selección"
            android:padding="12dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_close"
            app:tint="@color/umk_ink" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_selection_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 facturas"
                android:textColor="@color/umk_ink_soft"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_selection_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="C$ 0.00"
                android:textColor="@color/umk_ink"
                android:textFontWeight="800"
                android:textSize="20sp"
                app:autoSizeMaxTextSize="20sp"
                app:autoSizeMinTextSize="13sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_send_selection"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="18dp"
            android:stateListAnimator="@animator/button_press"
            android:text="Cobrar contado"
            android:textAllCaps="false"
            android:textColor="@color/umk_paper"
            android:textFontWeight="700"
            android:textSize="15sp"
            app:backgroundTint="@color/umk_royal"
            app:cornerRadius="14dp" />
    </LinearLayout>

</FrameLayout>
