<?xml version="1.0" encoding="utf-8"?>
<!-- Línea gráfica Unimark 20 años: logo a color sobre blanco + franja azul rey con ondas -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/umk_paper">

    <ImageView
        android:id="@+id/iv_splash_logo"
        android:layout_width="0dp"
        android:layout_height="104dp"
        android:layout_marginHorizontal="32dp"
        android:adjustViewBounds="true"
        android:contentDescription="Unimark 20 años"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_unimark_20"
        app:layout_constraintBottom_toTopOf="@id/splash_band_edge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45" />

    <TextView
        android:id="@+id/tv_splash_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:letterSpacing="0.14"
        android:text="GMV"
        android:textColor="@color/umk_royal"
        android:textFontWeight="800"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_splash_logo" />

    <TextView
        android:id="@+id/tv_splash_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Gestión Móvil de Ventas"
        android:textColor="@color/umk_ink_soft"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_splash_brand" />

    <ImageView
        android:id="@+id/splash_band_edge"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_band_waves"
        app:layout_constraintBottom_toTopOf="@id/splash_band"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/splash_band"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:background="@color/umk_royal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
