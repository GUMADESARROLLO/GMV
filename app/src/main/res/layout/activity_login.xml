<?xml version="1.0" encoding="utf-8"?>
<!-- Línea gráfica Unimark 20 años: blanco arriba con el logo, franja azul rey con ondas abajo -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/umk_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="40dp"
            android:paddingBottom="24dp">

            <!-- LOGO -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginBottom="36dp"
                android:adjustViewBounds="true"
                android:contentDescription="Unimark 20 años"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_unimark_20" />

            <!-- TITLE BLOCK -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.02"
                android:text="Bienvenido"
                android:textColor="@color/umk_royal"
                android:textFontWeight="800"
                android:textSize="30sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="28dp"
                android:text="Ingresa tus credenciales para continuar"
                android:textColor="@color/umk_ink_soft"
                android:textSize="15sp" />

            <!-- USUARIO -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUsername"
                style="@style/Widget.GMV.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Usuario"
                app:placeholderText="F00"
                app:startIconContentDescription="Usuario"
                app:startIconDrawable="@drawable/ic_user">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="username"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:minHeight="56dp"
                    android:singleLine="true"
                    android:textColor="@color/umk_ink"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- CONTRASEÑA: el ojo ahora sí alterna la visibilidad -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.GMV.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Contraseña"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/umk_ink_muted"
                app:startIconContentDescription="Contraseña"
                app:startIconDrawable="@drawable/ic_lock">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:minHeight="56dp"
                    android:singleLine="true"
                    android:textColor="@color/umk_ink"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ERROR TEXT (anunciado por lectores de pantalla) -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text=""
                android:textColor="@color/umk_danger"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- LOGIN BUTTON -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp">

                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_button_primary"
                    android:letterSpacing="0.06"
                    android:stateListAnimator="@animator/button_press"
                    android:text="Entrar"
                    android:textAllCaps="true"
                    android:textColor="@color/umk_paper"
                    android:textFontWeight="800"
                    android:textSize="16sp"
                    android:visibility="visible" />

                <ProgressBar
                    android:id="@+id/lytLoading"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="Ingresando"
                    android:indeterminateTint="@color/umk_paper"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>

        <!-- Franja azul con ondas -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/bg_band_waves" />

        <TextView
            android:id="@+id/loginBand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/umk_royal"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:text="GMV · Gestión Móvil de Ventas"
            android:textColor="@color/umk_on_royal_soft"
            android:textFontWeight="600"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
