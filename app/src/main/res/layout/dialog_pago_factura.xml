<?xml version="1.0" encoding="utf-8"?>
<!-- Registrar pago de una factura — mismo lenguaje que Solicitar aumento:
     campos blancos con borde (el activo con borde azul rey), teclado Widget.GMV.Tecla,
     selector de tipo como control segmentado y botón principal azul rey. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_chip_pill"
        android:backgroundTint="@color/umk_line" />

    <!-- Encabezado: título + saldo de la factura -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="-0.01"
            android:text="Registrar pago"
            android:textColor="@color/umk_ink"
            android:textFontWeight="800"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saldo"
                android:textColor="@color/umk_ink_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_saldo_dialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="C$ 0.00"
                android:textColor="@color/umk_danger"
                android:textFontWeight="800"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tipo de pago (control segmentado) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_abono"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:text="Abono"
            android:textAllCaps="false"
            android:textFontWeight="700"
            android:textSize="14sp"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancelacion"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:text="Cancelación"
            android:textAllCaps="false"
            android:textFontWeight="700"
            android:textSize="14sp"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_contado"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:text="Contado"
            android:textAllCaps="false"
            android:textFontWeight="700"
            android:textSize="14sp"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- Campos: tocar uno lo activa para el teclado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/lyt_field_nc"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_campo_monto"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Valor N/C"
                android:textColor="@color/umk_ink_soft"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_field_nc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:gravity="end"
                android:maxLines="1"
                android:text="0.00"
                android:textColor="@color/umk_ink"
                android:textFontWeight="800"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lyt_field_retencion"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_campo_monto"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Retención"
                android:textColor="@color/umk_ink_soft"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_field_retencion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:gravity="end"
                android:maxLines="1"
                android:text="0.00"
                android:textColor="@color/umk_ink"
                android:textFontWeight="800"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lyt_field_descuento"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_campo_monto"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descuento"
                android:textColor="@color/umk_ink_soft"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_field_descuento"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:gravity="end"
                android:maxLines="1"
                android:text="0.00"
                android:textColor="@color/umk_ink"
                android:textFontWeight="800"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lyt_field_recibido"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_campo_monto"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Valor recibido"
                android:textColor="@color/umk_ink_soft"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_field_recibido"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:gravity="end"
                android:maxLines="1"
                android:text="0.00"
                android:textColor="@color/umk_ink"
                android:textFontWeight="800"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Teclado -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="-5dp"
        android:layout_marginTop="10dp"
        android:columnCount="3">

            <Button android:id="@+id/btn_7" style="@style/KeyStyle" android:text="7" />
            <Button android:id="@+id/btn_8" style="@style/KeyStyle" android:text="8" />
            <Button android:id="@+id/btn_9" style="@style/KeyStyle" android:text="9" />

            <Button android:id="@+id/btn_4" style="@style/KeyStyle" android:text="4" />
            <Button android:id="@+id/btn_5" style="@style/KeyStyle" android:text="5" />
            <Button android:id="@+id/btn_6" style="@style/KeyStyle" android:text="6" />

            <Button android:id="@+id/btn_1" style="@style/KeyStyle" android:text="1" />
            <Button android:id="@+id/btn_2" style="@style/KeyStyle" android:text="2" />
            <Button android:id="@+id/btn_3" style="@style/KeyStyle" android:text="3" />

            <Button android:id="@+id/btn_0" style="@style/KeyStyle" android:text="0" />
            <Button android:id="@+id/btn_dot" style="@style/KeyStyle" android:text="." />
            <Button android:id="@+id/btn_delete" style="@style/KeyStyle" android:contentDescription="Borrar dígito" android:text="⌫" />
    </GridLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirmar_accion"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:stateListAnimator="@animator/button_press"
        android:text="@string/btn_agregar"
        android:textAllCaps="false"
        android:textColor="@color/umk_paper"
        android:textFontWeight="700"
        android:textSize="16sp"
        app:backgroundTint="@color/umk_royal"
        app:cornerRadius="14dp" />

</LinearLayout>
