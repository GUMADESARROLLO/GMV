<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_accent_pill_red"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SALDO VENCIDOS"
                android:textColor="@color/text_label"
                android:textSize="11sp"
                android:letterSpacing="0.12" />
        </LinearLayout>

        <include android:id="@+id/row_no_vencido" layout="@layout/item_aging_row"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/card_stroke" android:layout_marginVertical="2dp"/>

        <include android:id="@+id/row_d30" layout="@layout/item_aging_row"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/card_stroke" android:layout_marginVertical="2dp"/>

        <include android:id="@+id/row_d60" layout="@layout/item_aging_row"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/card_stroke" android:layout_marginVertical="2dp"/>

        <include android:id="@+id/row_d90" layout="@layout/item_aging_row"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/card_stroke" android:layout_marginVertical="2dp"/>

        <include android:id="@+id/row_d120" layout="@layout/item_aging_row"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/card_stroke" android:layout_marginVertical="2dp"/>

        <include android:id="@+id/row_m120" layout="@layout/item_aging_row"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_vencido_highlight"
            android:padding="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Vencido"
                android:textColor="@color/accent_red"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/id_saldo_vencido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="C$ 0.00"
                android:textColor="@color/accent_red"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
