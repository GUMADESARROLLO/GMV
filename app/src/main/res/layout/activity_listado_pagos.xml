<?xml version="1.0" encoding="utf-8"?>
<!-- Pagos registrados (carrito de recibo) — mismo lenguaje que Solicitudes / Detalle de factura -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/umk_mist"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_boton_circular"
            android:contentDescription="Regresar"
            android:padding="11dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_arrow_left"
            app:tint="@color/umk_ink" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_titulo_pagos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="-0.01"
                android:maxLines="1"
                android:text="Pagos registrados"
                android:textColor="@color/umk_ink"
                android:textFontWeight="800"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tv_cliente_pagos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/umk_ink_soft"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_clear_pagos"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_boton_circular"
            android:contentDescription="Vaciar pagos"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_trash"
            android:visibility="gone"
            app:tint="@color/umk_danger" />
    </LinearLayout>

    <!-- Lista -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_pagos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/lyt_pagos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Vacío -->
    <LinearLayout
        android:id="@+id/lyt_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_icono_tile"
            android:backgroundTint="@color/umk_royal_tint"
            android:importantForAccessibility="no"
            android:padding="14dp"
            android:src="@drawable/ic_receipt_long"
            app:tint="@color/umk_royal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="No hay pagos registrados"
            android:textColor="@color/umk_ink"
            android:textFontWeight="800"
            android:textSize="17sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Agrega pagos desde el detalle de cada factura"
            android:textColor="@color/umk_ink_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Panel inferior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel_inferior"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_continuar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@animator/button_press"
            android:text="Ver resumen del recibo"
            android:textAllCaps="false"
            android:textColor="@color/umk_paper"
            android:textFontWeight="700"
            android:textSize="16sp"
            app:backgroundTint="@color/umk_royal"
            app:cornerRadius="14dp" />
    </LinearLayout>

</LinearLayout>
