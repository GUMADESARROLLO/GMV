<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de orden: tarjeta blanca con borde línea (mismo estilo que item_reporte_factura).
     Arriba cliente + N° de orden; a la derecha monto (verde) y fecha. Abajo solo estado / eliminar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardOrden"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_tarjeta_perfil"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvClientName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="CLIENTE"
                android:textColor="@color/umk_ink"
                android:textFontWeight="800"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvOrderNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="Ord. N° 000000"
                android:textColor="@color/umk_ink_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMonto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="C$ 0.00"
                android:textColor="@color/umk_success"
                android:textFontWeight="800"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:text="00/00/0000"
                android:textColor="@color/umk_ink_soft"
                android:textFontWeight="600"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/divOrden"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/umk_line" />

    <LinearLayout
        android:id="@+id/lytOrdenPie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:minHeight="24dp"
        android:orientation="horizontal">

        <!-- Estado de la orden (color por backgroundTintList en el adapter) -->
        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_pill"
            android:backgroundTint="@color/status_pending_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Pendiente"
            android:textColor="@color/status_pending_text"
            android:textFontWeight="700"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Solo órdenes locales: 44dp de área táctil, ícono visual de 18dp -->
        <ImageButton
            android:id="@+id/ivDelete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Eliminar orden"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_trash"
            app:tint="@color/umk_danger" />
    </LinearLayout>
</LinearLayout>
