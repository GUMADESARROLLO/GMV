<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de métrica (mismo diseño que las del Perfil cliente):
     ícono en contenedor tintado + título / monto / subtítulo. Se llena desde código. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_tarjeta_perfil"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivMetricaIcono"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icono_tile"
        android:backgroundTint="@color/umk_royal_tint"
        android:importantForAccessibility="no"
        android:padding="9dp"
        android:src="@drawable/ic_monetization_on"
        app:tint="@color/umk_royal" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMetricaTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Título"
            android:textColor="@color/umk_ink_soft"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvMetricaValor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="C$ 0.00"
            android:textColor="@color/umk_ink"
            android:textFontWeight="800"
            android:textSize="16sp"
            app:autoSizeMaxTextSize="16sp"
            app:autoSizeMinTextSize="11sp"
            app:autoSizeTextType="uniform" />

        <TextView
            android:id="@+id/tvMetricaSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/umk_ink_muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
