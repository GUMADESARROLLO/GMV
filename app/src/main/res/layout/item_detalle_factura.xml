<?xml version="1.0" encoding="utf-8"?>
<!-- Artículo de una factura: código, descripción y abajo total de la línea (+ unitario) a la
     izquierda y cantidad a la derecha. Bonificados: chip "Bonificado" en lugar del total. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lyt_parent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_tarjeta_perfil"
    android:orientation="horizontal"
    android:padding="12dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:cardBackgroundColor="@color/umk_mist"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/iv_imagen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_placeholder_product" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_articulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:text="15010101"
            android:textColor="@color/umk_ink_muted"
            android:textFontWeight="700"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_descripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingMultiplier="1.05"
            android:text="ESPIRONOLACTONA 25 MG TABLETAS RECUBIERTAS 30/CAJA"
            android:textColor="@color/umk_ink"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Total de la línea (verde) o chip "Bonificado" -->
                <TextView
                    android:id="@+id/tv_total_linea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="C$ 0.00"
                    android:textColor="@color/umk_success"
                    android:textFontWeight="700"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_precio_unitario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="C$ 0.00 c/u"
                    android:textColor="@color/umk_ink_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_cantidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="0 UND"
                android:textColor="@color/umk_ink_soft"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
