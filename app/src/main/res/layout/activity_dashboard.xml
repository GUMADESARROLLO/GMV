<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorUmkPrimaryDark">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/tab_coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/tab_appbar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorUmkPrimaryDark"
            android:elevation="2dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_toStartOf="@+id/btn_add_cart"
                android:layout_toLeftOf="@+id/btn_add_cart"
                android:background="@color/colorUmkPrimary"
                android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
                app:layout_scrollFlags="scroll|enterAlways"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

                <LinearLayout
                    android:id="@+id/lyt_search_mode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/btn_search_back"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_arrow_left"
                        android:tint="?attr/colorOnSurface" />

                    <EditText
                        android:id="@+id/et_toolbar_search"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Buscar..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="@color/grey_40"
                        android:textSize="16sp" />

                    <ImageButton
                        android:id="@+id/btn_search_clear"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_close"
                        android:tint="@color/grey_40"
                        android:visibility="gone" />

                    <FrameLayout
                        android:id="@+id/lyt_cart_search"
                        android:layout_width="44dp"
                        android:layout_height="44dp">

                        <ImageButton
                            android:id="@+id/btn_search_cart"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:importantForAccessibility="no"
                            android:padding="10dp"
                            android:src="@drawable/ic_cart"
                            android:tint="@color/on_primary" />

                        <TextView
                            android:id="@+id/tv_cart_badge_search"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/bg_circle_red"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="@android:color/white"
                            android:textSize="7sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                    </FrameLayout>

                </LinearLayout>

                <FrameLayout
                    android:id="@+id/lyt_search_toolbar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end">

                    <ImageButton
                        android:id="@+id/btn_toolbar_search"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_search"
                        android:tint="@color/on_primary" />

                </FrameLayout>

                <FrameLayout
                    android:id="@+id/lyt_cart_toolbar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end">

                    <ImageButton
                        android:id="@+id/btn_toolbar_cart"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_cart"
                        android:tint="@color/on_primary" />

                    <TextView
                        android:id="@+id/tv_cart_badge_dashboard"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_circle_red"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@android:color/white"
                        android:textSize="7sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </FrameLayout>

            </com.google.android.material.appbar.MaterialToolbar>

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <include
        android:id="@+id/floating_nav"
        layout="@layout/nav_floating_island"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp" />

</RelativeLayout>
