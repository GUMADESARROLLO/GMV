<?xml version="1.0" encoding="utf-8"?>
<!-- Concepto (Retención / Descuento / N/C) dentro de la factura asociada a un recibo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_icono_tile"
    android:backgroundTint="@color/umk_mist"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="6dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/tvConceptLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Retención"
        android:textColor="@color/umk_ink_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvConceptAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:maxLines="1"
        android:text="C$ 0.00"
        android:textColor="@color/umk_ink"
        android:textFontWeight="700"
        android:textSize="12sp" />

</LinearLayout>
