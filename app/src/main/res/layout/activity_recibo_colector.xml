<?xml version="1.0" encoding="utf-8"?>
<!-- Resumen del recibo colector — mismo lenguaje que Solicitudes / Pagos registrados.
     El envío se confirma deslizando (DeslizarParaConfirmarView), igual que la solicitud de aumento. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/umk_mist"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_boton_circular"
            android:contentDescription="Regresar"
            android:padding="11dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_arrow_left"
            app:tint="@color/umk_ink" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:letterSpacing="-0.01"
            android:text="Recibo colector"
            android:textColor="@color/umk_ink"
            android:textFontWeight="800"
            android:textSize="20sp" />

        <!-- Cancelar recibo (descarta los pagos) -->
        <ImageButton
            android:id="@+id/btn_edit"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_boton_circular"
            android:contentDescription="Cancelar recibo"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="@color/umk_danger" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- Cliente -->
            <LinearLayout
                android:id="@+id/card_client"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_tarjeta_perfil"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_client_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_chip_pill"
                    android:backgroundTint="@color/umk_royal_tint"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="CL"
                    android:textColor="@color/umk_royal"
                    android:textFontWeight="800"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_client_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Nombre del cliente"
                        android:textColor="@color/umk_ink"
                        android:textFontWeight="800"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_client_direccion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFeatureSettings="tnum"
                        android:text=""
                        android:textColor="@color/umk_ink_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Fecha y número de recibo (tocables) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/card_fecha_recibo"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tarjeta_perfil"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_calendar_small"
                        app:tint="@color/umk_royal" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fecha"
                            android:textColor="@color/umk_ink_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_recibo_fecha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:text="0000-00-00"
                            android:textColor="@color/umk_ink"
                            android:textFontWeight="700"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_numero_recibo"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tarjeta_perfil"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_receipt"
                        app:tint="@color/umk_royal" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recibo N°"
                            android:textColor="@color/umk_ink_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_recibo_numero"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:text="—"
                            android:textColor="@color/umk_ink"
                            android:textFontWeight="700"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/umk_ink_muted" />
                </LinearLayout>
            </LinearLayout>

            <!-- Facturas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Facturas"
                    android:textColor="@color/umk_ink"
                    android:textFontWeight="800"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tv_facturas_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_pill"
                    android:backgroundTint="@color/umk_royal_tint"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="0"
                    android:textColor="@color/umk_royal"
                    android:textFontWeight="700"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lyt_pagos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Observaciones -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Observaciones"
                android:textColor="@color/umk_ink"
                android:textFontWeight="800"
                android:textSize="17sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/lyt_observaciones"
                style="@style/Widget.GMV.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:counterEnabled="true"
                app:counterMaxLength="250"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_observaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:hint="Escribe una nota para este recibo (opcional)"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="250"
                    android:minLines="3"
                    android:textColor="@color/umk_ink"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Panel inferior: total + deslizar para enviar -->
    <LinearLayout
        android:id="@+id/lyt_bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel_inferior"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total recibido"
                android:textColor="@color/umk_ink_soft"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_total_recibido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:letterSpacing="-0.02"
                android:text="C$ 0.00"
                android:textColor="@color/umk_success"
                android:textFontWeight="800"
                android:textSize="28sp" />
        </LinearLayout>

        <com.unimarksa.gmv.views.DeslizarParaConfirmarView
            android:id="@+id/btn_confirm"
            android:layout_width="match_parent"
            android:layout_height="60dp" />
    </LinearLayout>

</LinearLayout>
