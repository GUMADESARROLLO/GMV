<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floating_nav"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">

        <!-- ARTÍCULOS -->
        <LinearLayout
            android:id="@+id/nav_articulos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp">

            <ImageView
                android:id="@+id/iv_nav_articulos"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_article"
                android:tint="@color/nav_item_color" />

            <TextView
                android:id="@+id/tv_nav_articulos_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/label_articulos"
                android:textSize="10sp"
                android:textColor="@color/nav_item_color" />

        </LinearLayout>

        <!-- CLIENTES -->
        <LinearLayout
            android:id="@+id/nav_clientes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp">

            <ImageView
                android:id="@+id/iv_nav_clientes"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_people"
                android:tint="@color/nav_item_color" />

            <TextView
                android:id="@+id/tv_nav_clientes_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/label_clientes"
                android:textSize="10sp"
                android:textColor="@color/nav_item_color" />

        </LinearLayout>

        <!-- PERFIL -->
        <LinearLayout
            android:id="@+id/nav_perfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp">

            <ImageView
                android:id="@+id/iv_nav_perfil"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_person"
                android:tint="@color/nav_item_color" />

            <TextView
                android:id="@+id/tv_nav_perfil_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/label_perfil"
                android:textSize="10sp"
                android:textColor="@color/nav_item_color" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
