<?xml version="1.0" encoding="utf-8"?>
<!-- Isla de navegación flotante: píldora clara, cada pestaña con ícono + etiqueta siempre visibles.
     La activa se marca solo con color (azul rey) y peso; sin fondo extra. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floating_nav"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    app:cardBackgroundColor="@color/nav_pill_bg"
    app:cardCornerRadius="28dp"
    app:cardElevation="10dp"
    app:strokeColor="@color/nav_pill_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <!-- ARTÍCULOS -->
        <LinearLayout
            android:id="@+id/nav_articulos"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_articulos"
            android:gravity="center"
            android:minHeight="52dp"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/iv_nav_articulos"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_article" />

            <TextView
                android:id="@+id/tv_nav_articulos_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:importantForAccessibility="no"
                android:text="@string/nav_articulos"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- CLIENTES -->
        <LinearLayout
            android:id="@+id/nav_clientes"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_clientes"
            android:gravity="center"
            android:minHeight="52dp"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/iv_nav_clientes"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_people" />

            <TextView
                android:id="@+id/tv_nav_clientes_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:importantForAccessibility="no"
                android:text="@string/nav_clientes"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- PERFIL -->
        <LinearLayout
            android:id="@+id/nav_perfil"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_perfil"
            android:gravity="center"
            android:minHeight="52dp"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/iv_nav_perfil"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_person" />

            <TextView
                android:id="@+id/tv_nav_perfil_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:importantForAccessibility="no"
                android:text="@string/nav_perfil"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
