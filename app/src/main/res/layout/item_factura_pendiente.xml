<?xml version="1.0" encoding="utf-8"?>
<!-- Factura pendiente del perfil. Tocar = abrir detalle; mantener presionado = seleccionar
     (en modo selección, tocar alterna). Seleccionada: fondo azul claro con borde azul rey y check. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_tarjeta_perfil"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:id="@+id/lyt_icon_status"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_chip_pill"
            android:backgroundTint="@color/umk_royal_tint"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_status_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_receipt_long"
                app:tint="@color/umk_royal" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_factura_numero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="00296830"
                android:textColor="@color/umk_ink"
                android:textFontWeight="800"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_factura_estado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_pill"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Al día"
                    android:textColor="@color/perfil_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_factura_vencimiento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20-06-2026"
                    android:textColor="@color/perfil_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pendiente"
                android:textColor="@color/umk_ink_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_factura_saldo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="C$ 0.00"
                android:textColor="@color/umk_danger"
                android:textFontWeight="800"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_factura_facturado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="C$ 0.00"
                android:textColor="@color/perfil_text_muted"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
