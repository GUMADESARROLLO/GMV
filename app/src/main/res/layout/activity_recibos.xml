<?xml version="1.0" encoding="utf-8"?>
<!-- Recibos de colector — mismo lenguaje que Solicitudes / Perfil cliente:
     fondo claro, header con botones circulares, tarjetas blancas con borde línea. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/umk_mist"
    android:fitsSystemWindows="true"
    tools:context=".activities.RecibosActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_boton_circular"
                android:contentDescription="Regresar"
                android:padding="11dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_arrow_left"
                app:tint="@color/umk_ink" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="-0.01"
                android:maxLines="1"
                android:text="Recibos"
                android:textColor="@color/umk_ink"
                android:textFontWeight="800"
                android:textSize="20sp" />

            <!-- Antes: ítem action_anular_recibo del menú de la toolbar -->
            <ImageButton
                android:id="@+id/btn_anular_recibo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_boton_circular"
                android:contentDescription="Anular recibo por número"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:tooltipText="Anular recibo por número"
                app:srcCompat="@drawable/ic_card_off"
                app:tint="@color/umk_ink" />
        </LinearLayout>

        <!-- Filtro de fechas -->
        <LinearLayout
            android:id="@+id/layoutDateFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/cardDateFrom"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tarjeta_perfil"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar_small"
                    app:tint="@color/umk_royal" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Desde"
                        android:textColor="@color/umk_ink_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvDateFrom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:text=""
                        android:textColor="@color/umk_ink"
                        android:textFontWeight="700"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginHorizontal="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/umk_ink_muted" />

            <LinearLayout
                android:id="@+id/cardDateTo"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tarjeta_perfil"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar_small"
                    app:tint="@color/umk_royal" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hasta"
                        android:textColor="@color/umk_ink_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvDateTo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:text=""
                        android:textColor="@color/umk_ink"
                        android:textFontWeight="700"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Total del filtro en una línea fija (no se desplaza con la lista) -->
        <LinearLayout
            android:id="@+id/summaryBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_inferior"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvResumenTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="ÚLTIMOS 7 DÍAS"
                    android:textColor="@color/umk_ink"
                    android:textFontWeight="800"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvReceiptCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 recibos"
                    android:textColor="@color/umk_ink_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Total sin anulados -->
            <TextView
                android:id="@+id/tvTotalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="Σ C$ 0.00"
                android:textColor="@color/umk_success"
                android:textFontWeight="800"
                android:textSize="17sp" />
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp">

                    <!-- Vacío / error -->
                    <LinearLayout
                        android:id="@+id/lyt_empty_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="48dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_icono_tile"
                            android:backgroundTint="@color/umk_royal_tint"
                            android:importantForAccessibility="no"
                            android:padding="14dp"
                            android:src="@drawable/ic_receipt_long"
                            app:tint="@color/umk_royal" />

                        <TextView
                            android:id="@+id/tvEmptyTitulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Sin recibos"
                            android:textColor="@color/umk_ink"
                            android:textFontWeight="800"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/tvEmptySubtitulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="No hay recibos en este rango de fechas"
                            android:textColor="@color/umk_ink_muted"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerRecibos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_recibo" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Rangos rápidos fijos abajo (fijan Desde/Hasta; elegir fechas a mano deselecciona) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_inferior"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/lytRangos"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_segmentado_track"
                android:orientation="horizontal">

                <TextView android:id="@+id/rangoHoy" style="@style/Widget.GMV.Segmento" android:text="Hoy" />
                <TextView android:id="@+id/rango7" style="@style/Widget.GMV.Segmento" android:text="7 días" />
                <TextView android:id="@+id/rango30" style="@style/Widget.GMV.Segmento" android:text="30 días" />
                <TextView android:id="@+id/rangoMes" style="@style/Widget.GMV.Segmento" android:text="Este mes" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Cargando -->
    <FrameLayout
        android:id="@+id/lyt_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3F2F5FA"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminateTint="@color/umk_royal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Buscando recibos…"
                android:textColor="@color/umk_ink_soft"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
