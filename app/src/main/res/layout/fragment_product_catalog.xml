<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dashboard"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_card"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Catálogo de Productos"
        app:titleTextColor="?attr/colorOnSurface" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_buscar"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:hint="Buscar producto"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:startIconDrawable="@android:drawable/ic_menu_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_buscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_categorias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            app:chipSpacingHorizontal="6dp"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_todos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Todos"
                app:chipBackgroundColor="@color/accent_primary"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cardiovascular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cardiovascular" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_neurologico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Neurológico" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_pediatrico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pediátrico" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_oncologico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oncológico" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_dermatologico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dermatológico" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_gastrointestinal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gastrointestinal" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_endocrinologico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Endocrinológico" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_productos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="6dp"
        android:scrollbars="none" />

</LinearLayout>
