<?xml version="1.0" encoding="utf-8"?>
<!-- item_mora_row.xml
     Uso desde código:
       row_no_vencido.findViewById<View>(R.id.mora_dot).backgroundTintList = ...
       row_no_vencido.findViewById<TextView>(R.id.tv_mora_label).text = "No vencido"
       row_no_vencido.findViewById<TextView>(R.id.tv_mora_amount).text = "C$ 0.00"
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <!-- Dot indicador de riesgo (color se asigna desde código) -->
    <View
        android:id="@+id/mora_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/shape_circle"
        android:backgroundTint="@color/grey_20" />

    <!-- Etiqueta del tramo -->
    <TextView
        android:id="@+id/tv_mora_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:text="No vencido"
        android:textSize="13sp"
        android:textColor="@color/grey_80"
        app:fontFamily="sans-serif-medium" />

    <!-- Chip de monto -->
    <TextView
        android:id="@+id/tv_mora_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="C$ 0.00"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@drawable/bg_chip_neutral"
        android:textColor="@color/grey_60" />

</LinearLayout>
