<?xml version="1.0" encoding="utf-8"?>
<!-- Anular recibo por número (lanzado desde el header de Recibos) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tarjeta_perfil"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/id_title_frm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Anular recibo"
        android:textColor="@color/umk_ink"
        android:textFontWeight="800"
        android:textSize="18sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Indique el número y la fecha del recibo a anular."
        android:textColor="@color/umk_ink_muted"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:labelFor="@+id/edt_cantidad_vineta"
        android:text="Número de recibo"
        android:textColor="@color/umk_ink_soft"
        android:textFontWeight="700"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/edt_cantidad_vineta"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_dark"
        android:fontFeatureSettings="tnum"
        android:hint="Ej. 22357"
        android:importantForAutofill="no"
        android:inputType="number"
        android:paddingHorizontal="14dp"
        android:textColor="@color/umk_ink"
        android:textColorHint="@color/umk_ink_muted"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Fecha del recibo"
        android:textColor="@color/umk_ink_soft"
        android:textFontWeight="700"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/lyt_fecha_anular"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_calendar_small"
            app:tint="@color/umk_royal" />

        <TextView
            android:id="@+id/id_text_recibo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Seleccionar fecha del recibo"
            android:focusable="true"
            android:fontFeatureSettings="tnum"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:text="0000-00-00"
            android:textColor="@color/umk_ink"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bt_cancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/umk_ink"
            android:textFontWeight="700"
            android:textSize="15sp"
            app:cornerRadius="14dp"
            app:strokeColor="@color/umk_line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bt_add"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:backgroundTint="@color/umk_danger"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Anular"
            android:textAllCaps="false"
            android:textColor="@color/umk_paper"
            android:textFontWeight="700"
            android:textSize="15sp"
            app:cornerRadius="14dp" />
    </LinearLayout>

</LinearLayout>
