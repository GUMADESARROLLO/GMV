<?xml version="1.0" encoding="utf-8"?>
<!-- Campo de texto: blanco con borde de línea; al enfocar, borde azul rey (estado visible, no solo color de cursor) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/umk_paper" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/umk_royal" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/umk_paper" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/umk_line" />
        </shape>
    </item>
</selector>
